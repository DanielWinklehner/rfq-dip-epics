record(ai, "$(DEVICE):s8:get") {
    field(DESC, "Valve s8 relay state, 1 = energised")
    field(INP, "$(DEVICE):data.VAL[7] CA MS")
    field(SCAN, "Passive")
    field(PREC, "0")
