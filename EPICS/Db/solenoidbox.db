    field(DESC, "Valve s3 relay state, 1 = energised")
    field(INP, "$(DEVICE):data.VAL[2] CA MS")
    field(SCAN, "Passive")
    field(PREC, "0")
}
record(ai, "$(DEVICE):s4:get") {
    field(DESC, "Valve s4 relay state, 1 = energised")
    field(INP, "$(DEVICE):data.VAL[3] CA MS")
