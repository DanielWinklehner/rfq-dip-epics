# solenoidbox.db - solenoid valve box in the rack (AVR/devices/SolenoidValveBox)
#
# Author: Philip Weigel
#
# Macros: DEVICE (PV prefix, VALVE in the lab), PORT (asyn port, AVR12 in the lab).
# Load libcom1_device.db with the same macros for the identity records.
#
# Eight relays, channels s1..s8 in this order. A channel reads 1 when its relay is energised
# (output pin pulled LOW) and 0 when released. A set energises the relay for exactly 1 and
# releases it for any other value (set_solenoid() in the sketch). Power-on state: all released.
#
# In the lab (RAS/Devices.js, 2023) the channels were labelled s1 "Foreline Valve", s2 "MFC
# Shutoff Valve", s3 "Vent Valve", s4 "Faraday Cup". That is how this box is plumbed, not a
# property of the box type, so the descriptions below stay generic.
#
# The element records read the array through CA links with MS: when the box stops answering,
# :data goes INVALID and so does every read-back.
#
# First contact: after an IOC start each set record takes over the state of its relay, without
# sending anything. first_contact.db, loaded once per channel in the st.cmd with
# REQ=$(DEVICE):s<n>:set and RB=$(DEVICE):s<n>:get, copies the read-back into the set record
# at the read-back's first valid value, processed in simulation mode (no command to the box),
# and only if no client has written the set record since the start. Until the box has answered
# the set records stay INVALID (UDF): their state is not known. Writing a first value at the
# start instead (PINI) would close the foreline valve at every IOC start.

record(aai, "$(DEVICE):data") {
    field(DESC, "All solenoid statuses")
    field(DTYP, "stream")
    field(INP, "@libcom1.proto read_all_array $(PORT)")
    field(SCAN, ".5 second")
    field(NELM, "8")
    field(FTVL, "DOUBLE")
    field(FLNK, "$(DEVICE):int:fanout.PROC PP")
}

record(fanout, "$(DEVICE):int:fanout") {
    field(SELM, "All")
    field(LNK0, "$(DEVICE):s1:get")
    field(LNK1, "$(DEVICE):s2:get")
    field(LNK2, "$(DEVICE):s3:get")
    field(LNK3, "$(DEVICE):s4:get")
    field(LNK4, "$(DEVICE):s5:get")
    field(LNK5, "$(DEVICE):s6:get")
    field(LNK6, "$(DEVICE):s7:get")
    field(LNK7, "$(DEVICE):s8:get")
}

# Read-back: 1 = relay energised, 0 = released
record(ai, "$(DEVICE):s1:get") {
    field(DESC, "Valve s1 relay state, 1 = energised")
    field(INP, "$(DEVICE):data.VAL[0] CA MS")
    field(SCAN, "Passive")
    field(PREC, "0")
}
record(ai, "$(DEVICE):s2:get") {
    field(DESC, "Valve s2 relay state, 1 = energised")
    field(INP, "$(DEVICE):data.VAL[1] CA MS")
    field(SCAN, "Passive")
    field(PREC, "0")
}
