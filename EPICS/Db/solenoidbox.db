# The set records use acknowledged sets ("S<channel><value>", reply "ok"). A command the box
# rejects or does not answer puts the record into alarm instead of passing silently.
# This needs libcom1 protocol 2 firmware on the box: older firmware answers ERR0 and does
# NOT execute the set. Flash the firmware before loading this database.
# s1..s4 are bo and s5..s8 ao, as in the lab's database: 1 energises, anything else releases.
record(bo, "$(DEVICE):s1:set") {
    field(DESC, "Set valve s1 relay, 1 = energise")
    field(DTYP, "stream")
    field(PINI, "NO")
    field(OUT, "@libcom1.proto com1_setLink_ack(s1) $(PORT)")
}
record(bo, "$(DEVICE):s2:set") {
    field(DESC, "Set valve s2 relay, 1 = energise")
    field(DTYP, "stream")
    field(PINI, "NO")
    field(OUT, "@libcom1.proto com1_setLink_ack(s2) $(PORT)")
}
