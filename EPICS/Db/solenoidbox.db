    field(PREC, "0")
}
record(ai, "$(DEVICE):s5:get") {
    field(DESC, "Valve s5 relay state, 1 = energised")
    field(INP, "$(DEVICE):data.VAL[4] CA MS")
    field(SCAN, "Passive")
    field(PREC, "0")
}
record(ai, "$(DEVICE):s6:get") {
    field(DESC, "Valve s6 relay state, 1 = energised")
    field(INP, "$(DEVICE):data.VAL[5] CA MS")
