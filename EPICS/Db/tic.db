# tic.db - Edwards TIC controller, READ-ONLY (protocol: tic.proto, task T29)
#
# Macros (each with its default):
#   DEVICE  PV prefix, default TIC
#   PORT    asyn port, default TIC (RS-232: 9600 baud, 8 data bits, no parity, 1 stop bit,
#           Xon/Xoff; D397-12-880 Issue E 2.4.5; the port file sets the line)
#   PROTO   protocol file, default tic.proto. Room for RS-485 multi-drop (D397-30-880 1.6.1:
#           "#dd:ss" before the "?"): a second protocol file, named here; not built.
#
# Nothing here sends a command or a setup ("!C", "!S"); every record only queries. Source of
# every object, reply field and state word: Edwards D397-30-880 Issue H (see tic.proto).
#
# Scan: the three gauges every second, everything else every 2 s in one chain (FLNK) that
# starts at $(DEVICE):_sys. Line budget: docs/emulation/TIC.md.
#
# A pressure is valid only when the gauge's reply says units type 59 (pressure, pascal; 1.7.4)
# and gauge state 11 (On; 1.7.7). Otherwise, and when the controller does not answer, answers an
# error code or something else, getpressure is INVALID and its value NaN (never a stale or zero
# value), and gauge<n>:state:get says why in the words of 1.7.7 (or Table 3 for an error
# reply). The same for the pumps: a pump type 0 ("No Pump", 1.7.11) or an error reply (the
# controller has no such object) make state:get INVALID with the word "No Pump" or the error.
# Severities as in aim.db: a gauge that is off, striking or in error gives an INVALID pressure.
#
# Words longer than an mbbi string (25 characters) are shortened: "Invalid command for object
# ID" (Table 3, 1) -> "Invalid cmd for object ID"; the backing pump states of 1.7.6 without
# their last word "State" ("On Going Off Shutdown State" -> "On Going Off Shutdown").
# "No valid reply" (200) is not the manual's: no reply, or a reply of another form.
#
# Internal records start with "_". The value queries are calcout records (see tic.proto): their
# fields A.. hold the fields of the last reply, F the code of an error reply, -1 / NaN for none.


# ---------------------------------------------------------------- gauge 1 (object 913)

# A value, B units type, C state, D alert ID, E priority, F error code (-1: none)
record(calcout, "$(DEVICE=TIC):gauge1:_q") {
    field(DESC, "Gauge 1: ?V913")
    field(DTYP, "stream")
    field(OUT, "@$(PROTO=tic.proto) gauge(913) $(PORT=TIC)")
    field(SCAN, "$(SCAN=1 second)")
    field(CALC, "A:=NAN;B:=-1;C:=-1;D:=-1;E:=-1;F:=-1;0")
    field(FLNK, "$(DEVICE=TIC):gauge1:_ok")
}

# 1 when the reply is a pressure (units type 59) of a gauge that is on (state 11), else
# 0 and INVALID
record(calc, "$(DEVICE=TIC):gauge1:_ok") {
    field(DESC, "Gauge 1: a pressure, gauge on")
    field(INPA, "$(DEVICE=TIC):gauge1:_q.B NPP MS")
    field(INPB, "$(DEVICE=TIC):gauge1:_q.C NPP MS")
    field(CALC, "A=59&&B=11")
    field(LOLO, "0.5")
    field(LLSV, "INVALID")
    field(FLNK, "$(DEVICE=TIC):gauge1:getpressure")
}

# Pascal to torr: 1 torr = 101325/760 Pa = 133.322368 Pa
record(calc, "$(DEVICE=TIC):gauge1:getpressure") {
    field(DESC, "Gauge 1 pressure")
    field(INPA, "$(DEVICE=TIC):gauge1:_q.A NPP MS")
    field(INPB, "$(DEVICE=TIC):gauge1:_ok NPP MS")
    field(CALC, "B?A/133.322368:NAN")
    field(EGU, "torr")
    field(PREC, "2")
    field(LOPR, "1e-10")
    field(HOPR, "1000")
    field(FLNK, "$(DEVICE=TIC):gauge1:_code")
}

record(calc, "$(DEVICE=TIC):gauge1:_code") {
    field(DESC, "Gauge 1: state, 100+error, 200")
    field(INPA, "$(DEVICE=TIC):gauge1:_q.C NPP MS")
    field(INPB, "$(DEVICE=TIC):gauge1:_q.F NPP NMS")
    field(CALC, "B>=0?100+B:(A>=0?A:200)")
    field(FLNK, "$(DEVICE=TIC):gauge1:state:get")
}

# 1.7.7 Active gauge states; 101, 102 Table 3
record(mbbi, "$(DEVICE=TIC):gauge1:state:get") {
    field(DESC, "Gauge 1 state")
    field(DTYP, "Raw Soft Channel")
    field(INP,  "$(DEVICE=TIC):gauge1:_code NPP MS")
    field(ZRVL, "0")  field(ZRST, "Gauge Not connected")
    field(ONVL, "1")  field(ONST, "Gauge Connected")
    field(TWVL, "2")  field(TWST, "New Gauge Id")
    field(THVL, "3")  field(THST, "Gauge Change")
    field(FRVL, "4")  field(FRST, "Gauge In Alert")  field(FRSV, "MAJOR")
    field(FVVL, "5")  field(FVST, "Off")
    field(SXVL, "6")  field(SXST, "Striking")
    field(SVVL, "7")  field(SVST, "Initialising")
    field(EIVL, "8")  field(EIST, "Calibrating")
    field(NIVL, "9")  field(NIST, "Zeroing")
    field(TEVL, "10")  field(TEST, "Degassing")
    field(ELVL, "11")  field(ELST, "On")
    field(TVVL, "12")  field(TVST, "Inhibited")
    field(TTVL, "101")  field(TTST, "Invalid cmd for object ID")  field(TTSV, "INVALID")
    field(FTVL, "102")  field(FTST, "Invalid query/command")  field(FTSV, "INVALID")
    field(FFVL, "200")  field(FFST, "No valid reply")  field(FFSV, "INVALID")
    field(UNSV, "INVALID")
    field(FLNK, "$(DEVICE=TIC):gauge1:units:get")
}

# 1.7.4 SNVT values
record(mbbi, "$(DEVICE=TIC):gauge1:units:get") {
    field(DESC, "Gauge 1 units type")
    field(DTYP, "Raw Soft Channel")
    field(INP,  "$(DEVICE=TIC):gauge1:_q.B NPP MS")
    field(ZRVL, "59")  field(ZRST, "PRESSURE (Pa)")
    field(ONVL, "66")  field(ONST, "VOLTAGE")  field(ONSV, "MAJOR")
    field(TWVL, "81")  field(TWST, "PERCENT")  field(TWSV, "MAJOR")
    field(UNSV, "INVALID")
    field(FLNK, "$(DEVICE=TIC):gauge1:alert:get")
}

record(longin, "$(DEVICE=TIC):gauge1:alert:get") {
    field(DESC, "Gauge 1 alert ID (1.7.3)")
    field(INP, "$(DEVICE=TIC):gauge1:_q.D NPP MS")
    field(FLNK, "$(DEVICE=TIC):gauge1:priority:get")
}

# 1.7.2 Priority
record(mbbi, "$(DEVICE=TIC):gauge1:priority:get") {
    field(DESC, "Gauge 1 priority")
    field(DTYP, "Raw Soft Channel")
    field(INP,  "$(DEVICE=TIC):gauge1:_q.E NPP MS")
    field(ZRVL, "0")  field(ZRST, "OK")
    field(ONVL, "1")  field(ONST, "warning")  field(ONSV, "MINOR")
    field(TWVL, "2")  field(TWST, "alarm")  field(TWSV, "MAJOR")
    field(THVL, "3")  field(THST, "alarm")  field(THSV, "MAJOR")
    field(UNSV, "INVALID")
}

