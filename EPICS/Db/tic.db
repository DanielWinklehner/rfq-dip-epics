    field(SXVL, "6")  field(SXST, "Striking")
    field(SVVL, "7")  field(SVST, "Initialising")
    field(EIVL, "8")  field(EIST, "Calibrating")
    field(NIVL, "9")  field(NIST, "Zeroing")
    field(TEVL, "10")  field(TEST, "Degassing")
    field(ELVL, "11")  field(ELST, "On")
    field(TVVL, "12")  field(TVST, "Inhibited")
    field(TTVL, "101")  field(TTST, "Invalid cmd for object ID")  field(TTSV, "INVALID")
    field(FTVL, "102")  field(FTST, "Invalid query/command")  field(FTSV, "INVALID")
    field(FFVL, "200")  field(FFST, "No valid reply")  field(FFSV, "INVALID")
