# rek.db - the Matsusada REK supply (filament discharge) behind a CO series controller
#
# The same records as matsusada_au20p7.db (see there for the details), with other defaults:
#   DEV (REK), VFS (150) V, IFS (24) A (55 for the REK150-55), EGUI (A), PDIV (1): power in W,
#   PROTO (rek.proto). Other macros and defaults as in matsusada_au20p7.db: UNITNUM, PORT, POL,
#   VDRVL, VDRVH, PERMIT (interlock_open), ICN_ON (100), SCAN_MON (.1 second),
#   SCAN_GET (5 second), SCAN_STS (1 second), GRACE (5), POLL_LIMIT (30).
# Keep both files in step: the record part is matsusada_au20p7.db with these defaults.
#
# Author: Philip Weigel; reworked for MIST-2 in 2026 (current in A, not mA; power in W).

record(ao, "$(DEV=REK)-$(UNITNUM):voltage:setpoint") {
    field(DESC, "Set voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) set_voltage($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(DRVL, "$(VDRVL=0)")
    field(DRVH, "$(VDRVH=$(VFS=150))")
    field(EGU,  "V")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(POL=)$(VFS=150)")
    field(SIMM, "YES")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):voltage:get.PROC CA")
}

record(ai, "$(DEV=REK)-$(UNITNUM):voltage:get") {
    field(DESC, "Get voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) get_voltage($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(PINI, "YES")
    field(EGU,  "V")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(POL=)$(VFS=150)")
}

record(ai, "$(DEV=REK)-$(UNITNUM):voltage:read") {
    field(DESC, "Read voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) read_voltage($(UNITNUM)) $(PORT)")
    field(EGU,  "V")
    field(LINR, "SLOPE")
    field(ESLO, "2.442002442002442e-04")
    field(ASLO, "$(POL=)$(VFS=150)")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):current:read")
}

record(ao, "$(DEV=REK)-$(UNITNUM):current:setpoint") {
    field(DESC, "Set current of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) set_current($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(DRVL, "0")
    field(DRVH, "$(IFS=24)")
    field(EGU,  "$(EGUI=A)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(IFS=24)")
    field(SIMM, "YES")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):current:get")
}

# Read after every current set and by the FLNK of read_output_status (every SCAN_GET).
record(ai, "$(DEV=REK)-$(UNITNUM):current:get") {
    field(DESC, "Get current of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) get_current($(UNITNUM)) $(PORT)")
    field(PINI, "YES")
    field(EGU,  "$(EGUI=A)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(IFS=24)")
}

record(ai, "$(DEV=REK)-$(UNITNUM):current:read") {
    field(DESC, "Read current of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) read_current($(UNITNUM)) $(PORT)")
    field(EGU,  "$(EGUI=A)")
    field(LINR, "SLOPE")
    field(ESLO, "2.442002442002442e-04")
    field(ASLO, "$(IFS=24)")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):power:read")
}

record(calc, "$(DEV=REK)-$(UNITNUM):power:read") {
    field(DESC, "Read power of $(PORT):$(UNITNUM)")
    field(INPA, "$(DEV=REK)-$(UNITNUM):voltage:read NPP MS")
    field(INPB, "$(DEV=REK)-$(UNITNUM):current:read NPP MS")
    field(CALC, "A*B/$(PDIV=1)")
    field(PREC, "3")
    field(EGU,  "W")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):_poll:done")
}

# --- fast polling (internal records, _poll) ---------------------------------------------------
# The monitors are read as one cycle: voltage:read -> current:read -> power:read -> _poll:done.
# A new cycle starts when the last one is done AND a tick of SCAN_MON has come since the last
# start (the tick is remembered, not lost while the cycle runs). So each supply has at most one
# monitor request waiting for the line: when the line is full, the supplies of a chain take
# turns and share it evenly; when it is not, every supply is read once per SCAN_MON. Nothing
# about the other supplies of the chain needs to be known.
# Watchdog: if a cycle has not finished after POLL_LIMIT ticks, the next tick starts a new one
# (and _poll:tick shows MINOR while it is late), so a lost forward link cannot stop the polling.

# Every SCAN_MON: due := 1. VAL counts the ticks the current cycle has been running.
record(calcout, "$(DEV=REK)-$(UNITNUM):_poll:tick") {
    field(DESC, "Monitor tick (internal)")
    field(UDFS, "NO_ALARM")
    field(SCAN, "$(SCAN_MON=.1 second)")
    field(INPA, "$(DEV=REK)-$(UNITNUM):_poll:gate.C NPP")
    field(CALC, "E:=A?E+1:0;E")
    field(OOPT, "Every Time")
    field(DOPT, "Use OCAL")
    field(OCAL, "1")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):_poll:gate.A PP")
    field(HIGH, "$(POLL_LIMIT=30)")
    field(HSV,  "MINOR")
}

# A = due, C = cycle running, D = ticks it has been running. Starts a cycle when due and idle
# (or late), and then clears due and sets running.
record(calcout, "$(DEV=REK)-$(UNITNUM):_poll:gate") {
    field(DESC, "Starts a monitor cycle (internal)")
    field(UDFS, "NO_ALARM")
    field(INPD, "$(DEV=REK)-$(UNITNUM):_poll:tick.E NPP")
    field(CALC, "K:=A&&(!C||D>$(POLL_LIMIT=30));A:=K?0:A;C:=K?1:C;K")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):voltage:read.PROC PP")
}

# End of a cycle: running := 0, and the gate looks whether the next one is due.
record(dfanout, "$(DEV=REK)-$(UNITNUM):_poll:done") {
    field(DESC, "End of a monitor cycle (internal)")
    field(UDFS, "NO_ALARM")
    field(VAL,  "0")
    field(OUTA, "$(DEV=REK)-$(UNITNUM):_poll:tick.E NPP")
    field(OUTB, "$(DEV=REK)-$(UNITNUM):_poll:gate.C PP")
}

# --- output ------------------------------------------------------------------------------------

record(bo, "$(DEV=REK)-$(UNITNUM):SetToggleOutput") {
    field(DESC, "Set value for enabling PS output")
    field(ZNAM, "DISABLED")
    field(ONAM, "ENABLED")
}

# 0 while the permit is open, INVALID or disconnected (C: this record's own new severity, which
# input A raises to INVALID through MS or a broken link), otherwise the request. Writes the
# ToggleOutput only when the result changes. Disabled during the first GRACE seconds.
record(calcout, "$(DEV=REK)-$(UNITNUM):OutputIntlk") {
    field(DESC, "Forces the output off, permit open")
    field(INPA, "$(PERMIT=interlock_open) CP MS")
    field(INPB, "$(DEV=REK)-$(UNITNUM):SetToggleOutput CP")
    field(INPC, "$(DEV=REK)-$(UNITNUM):OutputIntlk.NSEV NPP")
    field(CALC, "(A||C>=3)?0:B")
    field(SCAN, "1 second")
    field(OOPT, "On Change")
    field(DOPT, "Use CALC")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):ToggleOutput PP")
    field(DISV, "1")
    field(DISA, "1")
}

record(bo, "$(DEV=REK)-$(UNITNUM):ToggleOutput") {
    field(DESC, "Toggle the status of the PS output")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) toggle_output($(UNITNUM),$(ICN_ON=100)) $(PORT)")
    field(PRIO, "HIGH")
    field(ZNAM, "DISABLED")
    field(ONAM, "ENABLED")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):read_output_status.PROC CA")
}

# NEW. At the start: request := output state read by the @init of ToggleOutput, and the same
# into OutputIntlk's previous value, so that the first evaluation sends nothing. After GRACE
# seconds (links connected) OutputIntlk is enabled and evaluated once, and the set points take
# the settings read from the supply (their :get records, read at PINI). The set points are in
# simulation mode until then (SIMM=YES: processed, nothing sent), so this sends nothing either.
# A write to a set point in the first GRACE seconds is therefore not sent.
record(seq, "$(DEV=REK)-$(UNITNUM):output:init") {
    field(DESC, "Request := output state at start")
    field(PINI, "YES")
    field(SELM, "All")
    field(DOL1, "$(DEV=REK)-$(UNITNUM):ToggleOutput NPP")
    field(LNK1, "$(DEV=REK)-$(UNITNUM):SetToggleOutput PP")
    field(DOL2, "$(DEV=REK)-$(UNITNUM):ToggleOutput NPP")
    field(LNK2, "$(DEV=REK)-$(UNITNUM):OutputIntlk.PVAL NPP")
    field(DLY3, "$(GRACE=5)")
    field(DO3,  "0")
    field(LNK3, "$(DEV=REK)-$(UNITNUM):OutputIntlk.DISA NPP")
    field(DO4,  "1")
    field(LNK4, "$(DEV=REK)-$(UNITNUM):OutputIntlk.PROC NPP")
    field(DOL5, "$(DEV=REK)-$(UNITNUM):voltage:get NPP MS")
    field(LNK5, "$(DEV=REK)-$(UNITNUM):voltage:setpoint PP MS")
    field(DO6,  "0")
    field(LNK6, "$(DEV=REK)-$(UNITNUM):voltage:setpoint.SIMM NPP")
    field(DOL7, "$(DEV=REK)-$(UNITNUM):current:get NPP MS")
    field(LNK7, "$(DEV=REK)-$(UNITNUM):current:setpoint PP MS")
    field(DO8,  "0")
    field(LNK8, "$(DEV=REK)-$(UNITNUM):current:setpoint.SIMM NPP")
}

# Output really on (STS: CO) or off (CF). Differs from read_output_status after a cut-off.
record(bi, "$(DEV=REK)-$(UNITNUM):status:read") {
    field(DESC, "Read status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) read_status($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_STS=1 second)")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

# The SW setting (SW?). It changes only by a switching command, so it is read after each one
# (FLNK of ToggleOutput) and otherwise slowly. Its FLNK reads the current setting, which the
# ICN of every switching changes.
record(bi, "$(DEV=REK)-$(UNITNUM):read_output_status") {
    field(DESC, "Read output status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) get_output_status($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):current:get")
}
