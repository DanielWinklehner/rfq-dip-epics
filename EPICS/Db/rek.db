# rek.db - the Matsusada REK supply (filament discharge) behind a CO series controller
#
# The same records as matsusada_au20p7.db (see there for the details), with other defaults:
#   DEV (REK), VFS (150) V, IFS (24) A (55 for the REK150-55), EGUI (A), PDIV (1): power in W,
#   PRECV (2), PRECI (3), PROTO (rek.proto). Other macros and defaults as in
#   matsusada_au20p7.db: UNITNUM, PORT, POL, VDRVL, VDRVH, PERMIT (interlock_open),
#   SCAN_MON (.1 second), SCAN_GET (5 second), SCAN_STS (1 second), GRACE (5), POLL_LIMIT (30).
# Keep both files in step: the record part is matsusada_au20p7.db with these defaults.
# Load supply_first_contact.db with every load of this file (macro S = DEV-UNITNUM, REK-1).
#
# Author: Philip Weigel; reworked for MIST-2 in 2026 (current in A, not mA; power in W).

# Voltage set point. Simulation mode (nothing sent) until it has taken over the supply's
# setting after the first contact (supply_first_contact.db); a write before that is not sent and
# is replaced by the supply's setting.
record(ao, "$(DEV=REK)-$(UNITNUM):voltage:setpoint") {
    field(DESC, "Set voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) set_voltage($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(DRVL, "$(VDRVL=0)")
    field(DRVH, "$(VDRVH=$(VFS=150))")
    field(EGU,  "V")
    field(PREC, "$(PRECV=2)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(POL=)$(VFS=150)")
    field(SIMM, "YES")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):voltage:get.PROC CA")
}

record(ai, "$(DEV=REK)-$(UNITNUM):voltage:get") {
    field(DESC, "Get voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) get_voltage($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(EGU,  "V")
    field(PREC, "$(PRECV=2)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(POL=)$(VFS=150)")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):_init:vtake")
}

record(ai, "$(DEV=REK)-$(UNITNUM):voltage:read") {
    field(DESC, "Read voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) read_voltage($(UNITNUM)) $(PORT)")
    field(EGU,  "V")
    field(PREC, "$(PRECV=2)")
    field(LINR, "SLOPE")
    field(ESLO, "2.442002442002442e-04")
    field(ASLO, "$(POL=)$(VFS=150)")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):current:read")
}

# NEW. The current limit (CH1). Restored by autosave, sent at the first contact and on every
# write, saved on every change.
record(ao, "$(DEV=REK)-$(UNITNUM):current:limit") {
    alias("$(DEV=REK)-$(UNITNUM):current:setpoint")
    field(DESC, "Current limit of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) set_current($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(DRVL, "0")
    field(DRVH, "$(IFS=24)")
    field(EGU,  "$(EGUI=A)")
    field(PREC, "$(PRECI=3)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(IFS=24)")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):current:get")
    info(autosaveFields, "VAL")
}

# The limit the supply reports. Read after every limit write and by the FLNK of
# read_output_status (every SCAN_GET).
record(ai, "$(DEV=REK)-$(UNITNUM):current:get") {
    field(DESC, "Get current of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) get_current($(UNITNUM)) $(PORT)")
    field(EGU,  "$(EGUI=A)")
    field(PREC, "$(PRECI=3)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(IFS=24)")
}

record(ai, "$(DEV=REK)-$(UNITNUM):current:read") {
    field(DESC, "Read current of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) read_current($(UNITNUM)) $(PORT)")
    field(EGU,  "$(EGUI=A)")
    field(PREC, "$(PRECI=3)")
    field(LINR, "SLOPE")
    field(ESLO, "2.442002442002442e-04")
    field(ASLO, "$(IFS=24)")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):power:read")
}

record(calc, "$(DEV=REK)-$(UNITNUM):power:read") {
    field(DESC, "Read power of $(PORT):$(UNITNUM)")
    field(INPA, "$(DEV=REK)-$(UNITNUM):voltage:read NPP MS")
    field(INPB, "$(DEV=REK)-$(UNITNUM):current:read NPP MS")
    field(CALC, "A*B/$(PDIV=1)")
    field(PREC, "3")
    field(EGU,  "W")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):_poll:done")
}

# --- fast polling (internal records, _poll) ---------------------------------------------------
# The monitors are read as one cycle: voltage:read -> current:read -> power:read -> _poll:done.
# A new cycle starts when the last one is done AND a tick of SCAN_MON has come since the last
# start (the tick is remembered, not lost while the cycle runs). So each supply has at most one
# monitor request waiting for the line: when the line is full, the supplies of a chain take
# turns and share it evenly; when it is not, every supply is read once per SCAN_MON. Nothing
# about the other supplies of the chain needs to be known.
# Watchdog: if a cycle has not finished after POLL_LIMIT ticks, the next tick starts a new one
# (and _poll:tick shows MINOR while it is late), so a lost forward link cannot stop the polling.
# None of these records turns INVALID when the port is closed (the monitors do).

# Every SCAN_MON: due := 1. VAL counts the ticks the current cycle has been running.
record(calcout, "$(DEV=REK)-$(UNITNUM):_poll:tick") {
    field(DESC, "Monitor tick (internal)")
    field(UDFS, "NO_ALARM")
    field(SCAN, "$(SCAN_MON=.1 second)")
    field(INPA, "$(DEV=REK)-$(UNITNUM):_poll:gate.C NPP")
    field(CALC, "E:=A?E+1:0;E")
    field(OOPT, "Every Time")
    field(DOPT, "Use OCAL")
    field(OCAL, "1")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):_poll:gate.A PP")
    field(HIGH, "$(POLL_LIMIT=30)")
    field(HSV,  "MINOR")
}

# A = due, C = cycle running, D = ticks it has been running. Starts a cycle when due and idle
# (or late), and then clears due and sets running.
record(calcout, "$(DEV=REK)-$(UNITNUM):_poll:gate") {
    field(DESC, "Starts a monitor cycle (internal)")
    field(UDFS, "NO_ALARM")
    field(INPD, "$(DEV=REK)-$(UNITNUM):_poll:tick.E NPP")
    field(CALC, "K:=A&&(!C||D>$(POLL_LIMIT=30));A:=K?0:A;C:=K?1:C;K")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):_poll:start PP")
}

# The gate starts the cycle through this soft record: a monitor that fails at once (closed port)
# then does not raise a link alarm in the gate.
record(fanout, "$(DEV=REK)-$(UNITNUM):_poll:start") {
    field(DESC, "Starts the monitor reads (internal)")
    field(UDFS, "NO_ALARM")
    field(LNK1, "$(DEV=REK)-$(UNITNUM):voltage:read")
}

# End of a cycle: running := 0, and the gate looks whether the next one is due.
record(dfanout, "$(DEV=REK)-$(UNITNUM):_poll:done") {
    field(DESC, "End of a monitor cycle (internal)")
    field(UDFS, "NO_ALARM")
    field(VAL,  "0")
    field(OUTA, "$(DEV=REK)-$(UNITNUM):_poll:tick.E NPP")
    field(OUTB, "$(DEV=REK)-$(UNITNUM):_poll:gate.C PP")
}

# --- first contact (internal records, _init) --------------------------------------------------

# Until the first answer after the IOC start: REN and SW? every SCAN_STS (and once at PINI).
# Each answer runs the take-over check _init:otake (supply_first_contact.db), which disables the
# probe at the first valid one (STAT DISABLE, no alarm).
record(bi, "$(DEV=REK)-$(UNITNUM):_init:probe") {
    field(DESC, "First contact: REN, SW? (internal)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) probe($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_STS=1 second)")
    field(PINI, "YES")
    field(UDFS, "NO_ALARM")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(DISV, "1")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):_init:otake")
}

# What follows the take-over of the output state (supply_first_contact.db, _init:otake:off runs
# it by its forward link, once per IOC start): reads the voltage echo (the set point takes it
# over, _init:vtake), sends the current limit if it is not applied (_limit:apply), and GRACE
# seconds later enables OutputIntlk and processes it. A seq: its steps are callbacks, which is
# what the delay needs; none of them switches a simulation mode or copies a value into a record
# that a client writes.
record(seq, "$(DEV=REK)-$(UNITNUM):output:init") {
    field(DESC, "First contact: echo, limit, gate")
    field(UDFS, "NO_ALARM")
    field(SELM, "All")
    field(DO1,  "1")
    field(LNK1, "$(DEV=REK)-$(UNITNUM):voltage:get.PROC CA")
    field(DO2,  "1")
    field(LNK2, "$(DEV=REK)-$(UNITNUM):_limit:apply.PROC NPP")
    field(DLY3, "$(GRACE=5)")
    field(DO3,  "0")
    field(LNK3, "$(DEV=REK)-$(UNITNUM):OutputIntlk.DISA NPP")
    field(DO4,  "1")
    field(LNK4, "$(DEV=REK)-$(UNITNUM):OutputIntlk.PROC NPP")
}

# Sends the current limit while it is not applied (never sent since the start: STAT UDF, also
# after autosave restored it; or the supply did not answer or did not take it: INVALID), from
# the first contact on, every SCAN_GET.
record(calcout, "$(DEV=REK)-$(UNITNUM):_limit:apply") {
    field(DESC, "Sends a limit not yet applied (internal)")
    field(UDFS, "NO_ALARM")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(INPA, "$(DEV=REK)-$(UNITNUM):current:limit.SEVR NPP")
    field(INPB, "$(DEV=REK)-$(UNITNUM):_init:probe.DISA NPP")
    field(INPC, "$(DEV=REK)-$(UNITNUM):current:limit.STAT NPP")
    field(CALC, "(A>=3||C=17)&&B")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):_limit:send PP")
}

# Through a soft record, so that a failing send does not raise a link alarm in _limit:apply.
record(fanout, "$(DEV=REK)-$(UNITNUM):_limit:send") {
    field(DESC, "Sends the current limit (internal)")
    field(UDFS, "NO_ALARM")
    field(LNK1, "$(DEV=REK)-$(UNITNUM):current:limit")
}

# --- output ------------------------------------------------------------------------------------

record(bo, "$(DEV=REK)-$(UNITNUM):SetToggleOutput") {
    field(DESC, "Set value for enabling PS output")
    field(ZNAM, "DISABLED")
    field(ONAM, "ENABLED")
}

# The permit as this IOC sees it, read every SCAN_MON and on every change. A permit PV of another
# IOC whose link is lost turns this record INVALID (LINK) at its next scan: a link to a
# disconnected PV neither processes its record nor reaches a calculation, so OutputIntlk reads
# the permit through this record, whose link (in this IOC) cannot be lost. Also INVALID at the
# start until the permit PV has connected.
record(ai, "$(DEV=REK)-$(UNITNUM):_permit:read") {
    field(DESC, "Output permit as seen here (internal)")
    field(INP,  "$(PERMIT=interlock_open) CP MS")
    field(SCAN, "$(SCAN_MON=.1 second)")
}

# 0 while the permit is open, INVALID or disconnected (C: this record's own new severity, which
# input A raises to INVALID through MS from _permit:read), otherwise the request. Starts the
# switching sequence (_out:switch) only when the result changes: an event. That the output stays
# off while the permit is lost, a state, is the work of _permit:enforce (below the latch).
# Disabled until GRACE seconds after the first contact (output:init).
record(calcout, "$(DEV=REK)-$(UNITNUM):OutputIntlk") {
    field(DESC, "Forces the output off, permit open")
    field(INPA, "$(DEV=REK)-$(UNITNUM):_permit:read CP MS")
    field(INPB, "$(DEV=REK)-$(UNITNUM):SetToggleOutput CP")
    field(INPC, "$(DEV=REK)-$(UNITNUM):OutputIntlk.NSEV NPP")
    field(CALC, "(A||C>=3)?0:B")
    field(SCAN, "1 second")
    field(OOPT, "On Change")
    field(DOPT, "Use OCAL")
    field(OCAL, "((A||C>=3)?0:B)?5:6")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):_out:switch.SELN PP")
    field(DISV, "1")
    field(DISA, "1")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):_permit:latch")
}

# Switching sequence. On (mask 5): _out:limit (REN, CH1 <limit>), then ToggleOutput (RST, SW1,
# SW? compared). Off (mask 6): _out:remote (REN), then ToggleOutput (RST, SW0, SW? compared).
# So the limit at the supply is right whenever an output goes on, also after a power cycle,
# and switching off sends no limit.
record(seq, "$(DEV=REK)-$(UNITNUM):_out:switch") {
    field(DESC, "Switching sequence (internal)")
    field(UDFS, "NO_ALARM")
    field(SELM, "Mask")
    field(SHFT, "0")
    field(LNK0, "$(DEV=REK)-$(UNITNUM):_out:limit.PROC PP")
    field(LNK1, "$(DEV=REK)-$(UNITNUM):_out:remote.PROC PP")
    field(DOL2, "$(DEV=REK)-$(UNITNUM):OutputIntlk NPP")
    field(LNK2, "$(DEV=REK)-$(UNITNUM):ToggleOutput PP")
}

record(bo, "$(DEV=REK)-$(UNITNUM):_out:limit") {
    field(DESC, "Switch on: REN, current limit (internal)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) switch_on_limit($(UNITNUM),$(DEV=REK)-$(UNITNUM):) $(PORT)")
    field(PRIO, "HIGH")
    field(UDFS, "NO_ALARM")
}

record(bo, "$(DEV=REK)-$(UNITNUM):_out:remote") {
    field(DESC, "Switch off: REN (internal)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) remote($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(UDFS, "NO_ALARM")
}

# The latch: while the permit is lost the request is cleared, so that nothing switches on when
# the permit comes back, and a request made while the permit is lost is cleared at once.
record(calcout, "$(DEV=REK)-$(UNITNUM):_permit:latch") {
    field(DESC, "Permit lost: request := 0 (internal)")
    field(UDFS, "NO_ALARM")
    field(INPA, "$(DEV=REK)-$(UNITNUM):OutputIntlk.A NPP")
    field(INPB, "$(DEV=REK)-$(UNITNUM):OutputIntlk.C NPP")
    field(CALC, "A||B>=3")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "0")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):SetToggleOutput PP")
}

# Off as a state (P45). While the gate is enabled, the permit is lost (as for the gate and the
# latch: OutputIntlk.A non-zero or OutputIntlk.C >= 3) and the supply reports its output on by a
# valid reading (read_output_status ON, or status:read ON or ON, LOCAL; SEVR below INVALID), the
# off sequence of _out:switch (mask 6: _out:remote REN, then ToggleOutput RST, SW0, SW? compared)
# is started again, the one the gate starts. The gate starts it only when its result changes, and
# its write can be lost: ToggleOutput still busy with a switch-on and the gate processed by its
# own scan, which carries no put flag (dbDbLink.c, processTarget). The same state remains after a
# client's direct write of ToggleOutput (P28) or a switch-on at the front panel while the permit
# is lost.
#   Inputs, all NPP database links (read, nothing processed): A, B OutputIntlk.A and .C (the
#   permit); C OutputIntlk.DISA (0: gate enabled); D, E read_output_status and its SEVR; F, G
#   status:read and its SEVR; H, I, J the PACT of _out:switch, ToggleOutput and
#   read_output_status (a switching or a read of SW? under way: the condition counts as not
#   fulfilled). K counts the evaluations in a row at which the condition held, L the sequences.
#   Every second: K := condition ? K+1 : 0. At K = 2 one sequence is started (L := L+1, so VAL
#   changes and On Change writes OCAL 6 to _out:switch.SELN PP) and K counts from 0 again. So
#   the first sequence goes out 1 to 2 s after the IOC has the reading, then one every 2 s while
#   the condition lasts. A normal permit loss starts none: the gate's own sequence keeps H, I or
#   J at 1 until SW? has been read back OFF, and status:read is read again within a second.
#   VAL: the number of sequences started since the IOC start (0 if nothing went wrong), for
#   diagnosis. No alarm of its own. It only switches off (SELN 6, never 5) and writes no request
#   (the latch does that). REN comes first, so a supply under local control is taken back.
#   A supply that does not answer: an INVALID reading does not count, so the sending stops.
#   After the supply falls silent, status:read is INVALID at its next poll (SCAN_STS) and
#   read_output_status at its next read, at the latest the read-back of the next sequence (FLNK
#   of ToggleOutput): at most one more sequence goes out. It starts again when the supply answers
#   and still reports on.
#   A unit that is not polled (SCAN_GET, SCAN_STS Passive): status:read is never read (INVALID,
#   UDF), so only read_output_status counts, which is read after every switching (FLNK of
#   ToggleOutput). A direct write of ToggleOutput is seen, a switch-on at the front panel is not.
# One hold of the lock set (EPICS 7.0.10 in our image): the periodic scan processes this record
# between dbScanLock and dbScanUnlock (dbScan.c 1013-1015, scanList). Its links are database
# links (no CA, CP or CPP: dbLink.c 118-121), and each puts its target into this record's lock
# set (dbDbLink.c 110, dbLockSetMerge). In that one dbProcess call the inputs are read without
# processing (only PP processes: dbDbLink.c 175-176), the expression is computed and, ODLY 0,
# the output written at once (calcoutRecord.c 237-238, 256-257, 284-285; devCalcoutSoft.c 43).
# The PP write to SELN processes _out:switch, which is idle because H was 0 under this lock
# (dbDbLink.c 387-389; processTarget 468-474, 512): the seq takes SELN, fixes its link groups
# and requests the callback of the first one (seqRecord.c 141-143, 152, 171, 179-196, 216). A
# client's write (dbAccess.c 1261-1280) and the completion of a StreamDevice record
# (StreamEpics.cc 1133-1135) take the same lock, so none comes between the check and the start.
# The seq runs its groups in callbacks with the lock released in between (seqRecord.c 252-274),
# as for the gate. A direct write of ToggleOutput in such a gap can make the sequence's SW0 be
# lost; then the condition holds again and the next sequence follows 2 s later.
record(calcout, "$(DEV=REK)-$(UNITNUM):_permit:enforce") {
    field(DESC, "Off again while permit lost (internal)")
    field(UDFS, "NO_ALARM")
    field(SCAN, "1 second")
    field(INPA, "$(DEV=REK)-$(UNITNUM):OutputIntlk.A NPP")
    field(INPB, "$(DEV=REK)-$(UNITNUM):OutputIntlk.C NPP")
    field(INPC, "$(DEV=REK)-$(UNITNUM):OutputIntlk.DISA NPP")
    field(INPD, "$(DEV=REK)-$(UNITNUM):read_output_status NPP")
    field(INPE, "$(DEV=REK)-$(UNITNUM):read_output_status.SEVR NPP")
    field(INPF, "$(DEV=REK)-$(UNITNUM):status:read NPP")
    field(INPG, "$(DEV=REK)-$(UNITNUM):status:read.SEVR NPP")
    field(INPH, "$(DEV=REK)-$(UNITNUM):_out:switch.PACT NPP")
    field(INPI, "$(DEV=REK)-$(UNITNUM):ToggleOutput.PACT NPP")
    field(INPJ, "$(DEV=REK)-$(UNITNUM):read_output_status.PACT NPP")
    field(CALC, "K:=(A||B>=3)&&C=0&&!(H||I||J)&&(D=1&&E<3||(F=1||F=3)&&G<3)?K+1:0;L:=L+(K>=2);K:=K>=2?0:K;L")
    field(OOPT, "On Change")
    field(DOPT, "Use OCAL")
    field(OCAL, "6")
    field(ODLY, "0")
    field(OUT,  "$(DEV=REK)-$(UNITNUM):_out:switch.SELN PP")
}

# Sends RST (cancel a cut-off) and SW, reads SW? back and compares it, after _out:limit or
# _out:remote (REN) of the switching sequence. In simulation mode only while the first contact
# takes it over (supply_first_contact.db). A client that writes ToggleOutput directly bypasses
# REN and the limit (P28). While the permit is lost such a switch-on lasts until _permit:enforce
# switches the output off again, 1 to 2 s after SW? has been read back ON.
record(bo, "$(DEV=REK)-$(UNITNUM):ToggleOutput") {
    field(DESC, "Toggle the status of the PS output")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=rek.proto) toggle_output($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(ZNAM, "DISABLED")
    field(ONAM, "ENABLED")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):read_output_status.PROC CA")
}

# STS: output really on (CO) or off (CF), and remote (RM) or local (LO). 0 and 1 are the lab's
# OFF and ON in remote mode; in local mode (front panel) 2 and 3, MINOR. Differs from
# read_output_status after a cut-off.
record(mbbi, "$(DEV=REK)-$(UNITNUM):status:read") {
    field(DESC, "Read status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) read_status($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_STS=1 second)")
    field(ZRST, "OFF")
    field(ONST, "ON")
    field(TWST, "OFF, LOCAL")
    field(THST, "ON, LOCAL")
    field(TWSV, "MINOR")
    field(THSV, "MINOR")
}

# The SW setting (SW?). It changes only by a switching command, so it is read after each one
# (FLNK of ToggleOutput) and otherwise slowly. Its FLNK reads the current limit back.
record(bi, "$(DEV=REK)-$(UNITNUM):read_output_status") {
    field(DESC, "Read output status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=rek.proto) get_output_status($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(FLNK, "$(DEV=REK)-$(UNITNUM):current:get")
}
