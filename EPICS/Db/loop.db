# loop.db - the records of one control loop, in the IOC of the actuator (iocHV for the discharge
# loop). Plain records, no device support and no C code. Design and operation: docs/emulation/LOOP.md.
#
# Two layers. The algorithm and the judgement (PID, anti-windup, bumpless switching, the decision
# to hand back or refuse) are the Python service loops/mist2loop, which knows the loop only by
# its prefix and works on these records over Channel Access. These records are the interface the
# operator sees and sets, and the backstop, which holds without any help from the service:
#   - the actuator is written only in PID, and only by _write, at most once per SCAN;
#   - what _write sends differs from the actuator's present set point by at most slew x DT;
#   - what _write sends lies between the actuator's present set point and the output limits: it
#     never moves the actuator away from the limits (after a limit change it brings it to the
#     new limit at the slew rate);
#   - once someone else has written the actuator in PID, _write does not write it again;
#   - PID needs the service alive: its counter _count must change within the watchdog time,
#     else the mode is MANUAL, the request is cleared (latch) and service:get alarms.
#
# Macros:
#   P          PV prefix of the loop
#   MEAS       measured value     } records of THIS IOC: a link in one IOC cannot be lost, and
#   ACT        actuator set point } the writer's PP link must reach ACT directly
#   HB         heartbeat of this IOC (a record that counts up once per second)
#   C1 R1 W1   permit condition 1: PV (of any IOC), the value it must have, and its words when
#   C2 R2 W2   it has not (at most 25 characters). A loop with fewer conditions repeats one.
#   C3 R3 W3
#   EGU        unit of the measured value                 PREC   its precision (3)
#   OEGU       unit of the actuator                       OPREC  its precision (2)
#   OLO OHI    range of the output limits that can be set (the actuator's range)
#   RES        resolution of the actuator: a smaller change is not written
#   SCAN       period of the writer _write (.2 second)    DT     the same in seconds (0.2)
# The settings are restored and saved by autosave (limits.defaults of the IOC, then limits.sav).
# The mode is not saved: after a start of the IOC the loop is in MANUAL.

# --- mode --------------------------------------------------------------------------------------

# The operator's request. Cleared (MANUAL) by the service when it hands back or refuses, and by
# _drop when the service is not alive: nothing returns to PID by itself.
record(bo, "$(P):mode:setpoint") {
    field(DESC, "Mode request")
    field(ZNAM, "MANUAL")
    field(ONAM, "PID")
}

# PID only while requested, accepted by the service (_active) and the service alive.
record(calc, "$(P):_mode") {
    field(DESC, "Mode (internal)")
    field(INPA, "$(P):mode:setpoint CP")
    field(INPB, "$(P):service:get CP")
    field(INPC, "$(P):_active CP")
    field(CALC, "A&&B&&C")
    field(FLNK, "$(P):mode:get")
}

record(bi, "$(P):mode:get") {
    field(DESC, "Mode")
    field(INP,  "$(P):_mode NPP")
    field(ZNAM, "MANUAL")
    field(ONAM, "PID")
}

# Written by the service: 1 when it has accepted the request (after its checks), 0 when it hands
# back.
record(bo, "$(P):_active") {
    field(DESC, "PID accepted by the service (internal)")
}

# Why the loop last handed back or refused, until the next request. Written by the service and by
# _drop. The order of the states is REASONS in loops/mist2loop/loop.py.
# PINI: processed once at the start, so that "IOC start" is a valid value and not a record that
# was never processed (UDF, INVALID) until the next request.
record(mbbi, "$(P):reason:get") {
    field(DESC, "Last hand-back or refusal")
    field(INP,  "1")
    field(PINI, "YES")
    field(ZRST, "none")
    field(ONST, "IOC start")
    field(TWST, "service start")
    field(THST, "$(W1=permit 1 not met)")
    field(FRST, "$(W2=permit 2 not met)")
    field(FVST, "$(W3=permit 3 not met)")
    field(SXST, "permit 1 no data")
    field(SVST, "permit 2 no data")
    field(EIST, "permit 3 no data")
    field(NIST, "measurement no data")
    field(TEST, "actuator no data")
    field(ELST, "measurement stale")
    field(TVST, "written by someone else")
    field(TTST, "set not accepted")
    field(FTST, "outside output limits")
    field(FFST, "service stopped")
}

# --- the service's watchdog ----------------------------------------------------------------------

# Counted up by the service once per cycle.
record(longout, "$(P):_count") {
    field(DESC, "Service counter (internal)")
}

# 1 while _count changed within the watchdog time, else 0 (MAJOR). B: seconds since the last
# change (starts as "never"), C: the value seen last.
record(calc, "$(P):service:get") {
    field(DESC, "Loop service alive")
    field(SCAN, ".1 second")
    field(INPA, "$(P):_count NPP")
    field(INPD, "$(P):watchdog:setpoint NPP")
    field(B,    "1e9")
    field(CALC, "B:=(A#C)?0:B+0.1;C:=A;B<D")
    field(LOW,  "0.5")
    field(LSV,  "MAJOR")
}

# The service not alive while PID is requested or accepted: back to MANUAL.
record(calcout, "$(P):_dead") {
    field(DESC, "Service not alive: drop (internal)")
    field(INPA, "$(P):service:get CP")
    field(INPB, "$(P):mode:setpoint CP")
    field(INPC, "$(P):_active CP")
    field(CALC, "!A&&(B||C)")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P):_drop.PROC PP")
}

record(seq, "$(P):_drop") {
    field(DESC, "Request and acceptance off (internal)")
    field(SELM, "All")
    field(DO1,  "0")
    field(LNK1, "$(P):mode:setpoint PP")
    field(DO2,  "0")
    field(LNK2, "$(P):_active PP")
    field(DO3,  "15")
    field(LNK3, "$(P):reason:get PP")
}

# --- permits, measurement, actuator ----------------------------------------------------------------

# Permit conditions. For each: _cN reads the PV, on every change and every SCAN, so that a link
# to another IOC that is lost turns it INVALID (LINK) at its next scan (a lost Channel Access
# link does not process its record by itself). _sN: 0 fulfilled, 1 not fulfilled, 2 no data
# (_cN INVALID: its PV INVALID, not connected, or never connected since the start).
# permitN:get shows it as words for every client: "fulfilled", the condition's words, "no data"
# (INVALID). Not fulfilled carries no alarm: an off supply is a normal state.
record(ai, "$(P):_c1") {
    field(DESC, "Permit condition 1, read (internal)")
    field(INP,  "$(C1) CP MSI")
    field(SCAN, "$(SCAN=.2 second)")
    field(FLNK, "$(P):_s1")
}

record(calc, "$(P):_s1") {
    field(DESC, "Permit condition 1, state (internal)")
    field(INPA, "$(P):_c1 NPP MSI")
    field(INPB, "$(P):_c1.SEVR NPP")
    field(CALC, "B>=3?2:(ABS(A-($(R1)))<0.5?0:1)")
    field(FLNK, "$(P):permit1:get")
}

record(mbbi, "$(P):permit1:get") {
    field(DESC, "Permit condition 1")
    field(INP,  "$(P):_s1 NPP MSI")
    field(ZRST, "fulfilled")
    field(ONST, "$(W1=permit 1 not met)")
    field(TWST, "no data")
    field(TWSV, "INVALID")
}

record(ai, "$(P):_c2") {
    field(DESC, "Permit condition 2, read (internal)")
    field(INP,  "$(C2) CP MSI")
    field(SCAN, "$(SCAN=.2 second)")
    field(FLNK, "$(P):_s2")
}

record(calc, "$(P):_s2") {
    field(DESC, "Permit condition 2, state (internal)")
    field(INPA, "$(P):_c2 NPP MSI")
    field(INPB, "$(P):_c2.SEVR NPP")
    field(CALC, "B>=3?2:(ABS(A-($(R2)))<0.5?0:1)")
    field(FLNK, "$(P):permit2:get")
}

record(mbbi, "$(P):permit2:get") {
    field(DESC, "Permit condition 2")
    field(INP,  "$(P):_s2 NPP MSI")
    field(ZRST, "fulfilled")
    field(ONST, "$(W2=permit 2 not met)")
    field(TWST, "no data")
    field(TWSV, "INVALID")
}

record(ai, "$(P):_c3") {
    field(DESC, "Permit condition 3, read (internal)")
    field(INP,  "$(C3) CP MSI")
    field(SCAN, "$(SCAN=.2 second)")
    field(FLNK, "$(P):_s3")
}

record(calc, "$(P):_s3") {
    field(DESC, "Permit condition 3, state (internal)")
    field(INPA, "$(P):_c3 NPP MSI")
    field(INPB, "$(P):_c3.SEVR NPP")
    field(CALC, "B>=3?2:(ABS(A-($(R3)))<0.5?0:1)")
    field(FLNK, "$(P):permit3:get")
}

record(mbbi, "$(P):permit3:get") {
    field(DESC, "Permit condition 3")
    field(INP,  "$(P):_s3 NPP MSI")
    field(ZRST, "fulfilled")
    field(ONST, "$(W3=permit 3 not met)")
    field(TWST, "no data")
    field(TWSV, "INVALID")
}

# The measured value as the loop reads it: INVALID while the measurement is.
record(ai, "$(P):value:read") {
    field(DESC, "Measured value")
    field(INP,  "$(MEAS) CP MS")
    field(EGU,  "$(EGU)")
    field(PREC, "$(PREC=3)")
}

# The actuator's set point with its severity, for the service.
record(ai, "$(P):_act") {
    field(DESC, "Actuator set point (internal)")
    field(INP,  "$(ACT) CP MS")
    field(PREC, "$(OPREC=2)")
}

record(ai, "$(P):_hb") {
    field(DESC, "Heartbeat of the IOC (internal)")
    field(INP,  "$(HB) CP")
}

# --- output: the backstop ------------------------------------------------------------------------

# The service's output (its target for the actuator).
record(ao, "$(P):_out") {
    field(DESC, "Output of the service (internal)")
    field(PREC, "$(OPREC=2)")
}

# The actuator's next value: _out within [outmin, outmax] (I), then the actuator's present set
# point E moved towards it by at most slew x DT. Processed by _write.
record(calc, "$(P):_target") {
    field(DESC, "Next actuator value (internal)")
    field(INPA, "$(P):_out NPP")
    field(INPB, "$(P):outmin:setpoint NPP")
    field(INPC, "$(P):outmax:setpoint NPP")
    field(INPD, "$(P):slew:setpoint NPP")
    field(INPE, "$(ACT) NPP")
    field(INPH, "$(DT=0.2)")
    field(CALC, "I:=MIN(MAX(A,B),C);E+MIN(MAX(I-E,-D*H),D*H)")
    field(PREC, "$(OPREC=2)")
}

# Every SCAN: writes the target A to the actuator only in PID (F), with valid limits
# (outmin < outmax), when it differs from the actuator's set point E by RES or more, and while E
# is still the value this record wrote last (L; at the first scan in PID, K = 0, L is taken from
# E): once someone else has written the actuator, the loop does not write it again (the operator
# has priority). A lies between E and a point within the limits (_target), so a write never
# moves the actuator away from the limits.
record(calcout, "$(P):_write") {
    field(DESC, "Writes the actuator (internal)")
    field(SCAN, "$(SCAN=.2 second)")
    field(INPA, "$(P):_target PP")
    field(INPB, "$(P):outmin:setpoint NPP")
    field(INPC, "$(P):outmax:setpoint NPP")
    field(INPE, "$(ACT) NPP")
    field(INPF, "$(P):_mode NPP")
    field(INPG, "$(RES)")
    field(CALC, "L:=F&&!K?E:L;K:=F;F&&B<C&&ABS(A-E)>=G&&ABS(E-L)<1E-6")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "L:=A;A")
    field(OUT,  "$(ACT) PP")
    field(PREC, "$(OPREC=2)")
}

# --- what the service shows (written by it each cycle) ---------------------------------------------
# PINI: processed once at the start, so that they are valid (0, "free") from the IOC's start on and
# not undefined (UDF, INVALID) until the service has connected and written them.

record(mbbi, "$(P):limit:get") {
    field(DESC, "Output held back by a limit")
    field(INP,  "0")
    field(PINI, "YES")
    field(ZRST, "free")
    field(ONST, "at minimum")
    field(TWST, "at maximum")
    field(THST, "slew limited")
    field(ONSV, "MINOR")
    field(TWSV, "MINOR")
}

record(ai, "$(P):output:get") {
    field(DESC, "Output (actuator set point)")
    field(INP,  "0")
    field(PINI, "YES")
    field(EGU,  "$(OEGU)")
    field(PREC, "$(OPREC=2)")
}

record(ai, "$(P):error:get") {
    field(DESC, "Error: set point - measured")
    field(INP,  "0")
    field(PINI, "YES")
    field(EGU,  "$(EGU)")
    field(PREC, "$(PREC=3)")
}

record(ai, "$(P):p:get") {
    field(DESC, "Proportional term")
    field(INP,  "0")
    field(PINI, "YES")
    field(EGU,  "$(OEGU)")
    field(PREC, "$(OPREC=2)")
}

record(ai, "$(P):i:get") {
    field(DESC, "Integral term")
    field(INP,  "0")
    field(PINI, "YES")
    field(EGU,  "$(OEGU)")
    field(PREC, "$(OPREC=2)")
}

record(ai, "$(P):d:get") {
    field(DESC, "Derivative term")
    field(INP,  "0")
    field(PINI, "YES")
    field(EGU,  "$(OEGU)")
    field(PREC, "$(OPREC=2)")
}

# --- settings (autosave) -------------------------------------------------------------------------
# PINI: processed once at the start, so that a value restored by autosave is a valid value, not
# a record that was never processed (UDF).

# Set point. Its drive limits DRVL and DRVH are set by spmin and spmax: a write outside them is
# clamped.
record(ao, "$(P):value:setpoint") {
    field(DESC, "Set point")
    field(EGU,  "$(EGU)")
    field(PREC, "$(PREC=3)")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

# The set point limits. Each writes its drive limit of the set point and processes the set point,
# so that a limit moved inside the present set point brings the set point to the limit (the loop
# follows through its slew limit).
record(ao, "$(P):spmin:setpoint") {
    field(DESC, "Set point minimum")
    field(EGU,  "$(EGU)")
    field(PREC, "$(PREC=3)")
    field(OUT,  "$(P):value:setpoint.DRVL NPP")
    field(FLNK, "$(P):value:setpoint")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):spmax:setpoint") {
    field(DESC, "Set point maximum")
    field(EGU,  "$(EGU)")
    field(PREC, "$(PREC=3)")
    field(OUT,  "$(P):value:setpoint.DRVH NPP")
    field(FLNK, "$(P):value:setpoint")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

# Gains are not negative: the loop is for an actuator that raises the measured value.
record(ao, "$(P):kp:setpoint") {
    field(DESC, "Proportional gain")
    field(EGU,  "$(OEGU)/$(EGU)")
    field(PREC, "3")
    field(DRVL, "0")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):ki:setpoint") {
    field(DESC, "Integral gain, per second")
    field(EGU,  "$(OEGU)/$(EGU)/s")
    field(PREC, "3")
    field(DRVL, "0")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):kd:setpoint") {
    field(DESC, "Derivative gain, seconds")
    field(EGU,  "$(OEGU)s/$(EGU)")
    field(PREC, "3")
    field(DRVL, "0")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):dfilter:setpoint") {
    field(DESC, "Derivative filter time")
    field(EGU,  "s")
    field(PREC, "2")
    field(DRVL, "0")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):outmin:setpoint") {
    field(DESC, "Output minimum")
    field(EGU,  "$(OEGU)")
    field(PREC, "$(OPREC=2)")
    field(DRVL, "$(OLO)")
    field(DRVH, "$(OHI)")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):outmax:setpoint") {
    field(DESC, "Output maximum")
    field(EGU,  "$(OEGU)")
    field(PREC, "$(OPREC=2)")
    field(DRVL, "$(OLO)")
    field(DRVH, "$(OHI)")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

# 0 holds the output where it is.
record(ao, "$(P):slew:setpoint") {
    field(DESC, "Largest output change per second")
    field(EGU,  "$(OEGU)/s")
    field(PREC, "3")
    field(DRVL, "0")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):stale:setpoint") {
    field(DESC, "Heartbeat stopped longer: hand back")
    field(EGU,  "s")
    field(PREC, "1")
    field(DRVL, "0")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}

record(ao, "$(P):watchdog:setpoint") {
    field(DESC, "Service silent longer: MANUAL")
    field(EGU,  "s")
    field(PREC, "1")
    field(DRVL, "0")
    field(PINI, "YES")
    info(autosaveFields, "VAL")
}
