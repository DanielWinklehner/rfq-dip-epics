# matsusada_au20p7.db - one Matsusada AU supply behind a CO series controller (CO-U32, CO-HV)
#
# Terminology: "setpoint" changes the set point, "limit" is the current limit, "get" reads a
# setting back from the supply, "read" measures the output.
#
# Macros (default):
#   UNITNUM              unit number on the chain (UNIT switch of the CO-HV), also in the PV names
#   PORT                 asyn port of the chain
#   DEV (AU-20P7)        PV prefix, the PVs are DEV-UNITNUM:...
#   VFS (20000), IFS (7.5)   full scale in V and mA
#   POL (empty)          sign of the voltage PVs: empty = positive, "-" = negative numbers.
#                        With "-" also set VDRVL=-VFS and VDRVH=0.
#   VDRVL (0), VDRVH (VFS)   drive limits of the voltage set point
#   PERMIT (interlock_open)  output permit PV: non-zero = open. An INVALID or disconnected permit
#                        counts as open. Losing the permit switches the output off and clears
#                        the request: it latches, the operator switches on again
#   SCAN_MON (.1 second) monitors (MN1, MN2): at most this often, evenly shared on a full line
#   POLL_LIMIT (30)      ticks of SCAN_MON after which an unfinished monitor cycle is restarted
#   SCAN_GET (5 second)  set-point echoes (CH0?, CH1?) and the SW setting; also read after
#                        every set and every switching; retry of a limit not yet applied
#   SCAN_STS (1 second)  output state and remote/local (STS); first-contact probe
#                        Passive for all three: the supply is not polled (no bus traffic after
#                        the one probe at the start)
#   GRACE (5)            seconds after the first contact before the permit can switch the output
#   PDIV (1000)          power:read = voltage:read * current:read / PDIV, in W
#   EGUI (mA)            unit of the current PVs
#   PRECV (0), PRECI (3) digits after the decimal point that a client shows for voltages and currents
#   PROTO (matsusada_co_ctrl.proto)
#
# Sets carry no acknowledgement (the CO series does not answer a set). Each set reads the
# setting back in the same protocol and compares it: a supply that does not answer or does not
# execute the set turns the set record INVALID (TIMEOUT or CALC). The echo record (:get) is read
# after every set as well.
#
# First contact. Until a supply has answered once after the IOC start, _init:probe sends REN and
# SW? every SCAN_STS. At the first valid answer the output state is taken over into
# ToggleOutput, the request and OutputIntlk (nothing is sent) and the probe stops; then
# output:init reads the voltage echo, sends the current limit (_limit:apply), and GRACE seconds
# later OutputIntlk starts to act. At the first valid echo the voltage set point takes over the
# setting the supply reports (nothing sent; until then it is in simulation mode). The take-overs
# are the records of supply_first_contact.db, which is loaded with every load of this file
# (macro S = DEV-UNITNUM): each runs under one hold of the lock set, so that no client's write
# comes between its steps (see its header). A supply that cannot be reached at the start is
# taken over in the same way when it answers.
# REN is sent only by the probe and by every switching (as in the lab), so the front panel can
# take local control; status:read shows it. Switching on sends the current limit after REN.
#
# The current limit (current:limit, also under the lab's name current:setpoint) is not taken
# over from the supply: it comes from autosave (defaults file, then the file saved at run time,
# see the st.cmd) and is sent at the first contact. While it is not applied (INVALID), it is
# sent again every SCAN_GET. A client write goes to the supply and into the saved file
# (info autosaveFields).
#
# rek.db is the same file with other defaults. Keep both in step.
#
# Authors: Ryan Yang (ryang2@mit.edu), 2021; reworked for MIST-2 in 2026.

# Voltage set point. Simulation mode (nothing sent) until it has taken over the supply's
# setting after the first contact (supply_first_contact.db); a write before that is not sent and
# is replaced by the supply's setting.
record(ao, "$(DEV=AU-20P7)-$(UNITNUM):voltage:setpoint") {
    field(DESC, "Set voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=matsusada_co_ctrl.proto) set_voltage($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(DRVL, "$(VDRVL=0)")
    field(DRVH, "$(VDRVH=$(VFS=20000))")
    field(EGU,  "V")
    field(PREC, "$(PRECV=0)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(POL=)$(VFS=20000)")
    field(SIMM, "YES")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):voltage:get.PROC CA")
}

record(ai, "$(DEV=AU-20P7)-$(UNITNUM):voltage:get") {
    field(DESC, "Get voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=matsusada_co_ctrl.proto) get_voltage($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(EGU,  "V")
    field(PREC, "$(PRECV=0)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(POL=)$(VFS=20000)")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):_init:vtake")
}

record(ai, "$(DEV=AU-20P7)-$(UNITNUM):voltage:read") {
    field(DESC, "Read voltage of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=matsusada_co_ctrl.proto) read_voltage($(UNITNUM)) $(PORT)")
    field(EGU,  "V")
    field(PREC, "$(PRECV=0)")
    field(LINR, "SLOPE")
    field(ESLO, "2.442002442002442e-04")
    field(ASLO, "$(POL=)$(VFS=20000)")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):current:read")
}

# NEW. The current limit (CH1). Restored by autosave, sent at the first contact and on every
# write, saved on every change.
record(ao, "$(DEV=AU-20P7)-$(UNITNUM):current:limit") {
    alias("$(DEV=AU-20P7)-$(UNITNUM):current:setpoint")
    field(DESC, "Current limit of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=matsusada_co_ctrl.proto) set_current($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(DRVL, "0")
    field(DRVH, "$(IFS=7.5)")
    field(EGU,  "$(EGUI=mA)")
    field(PREC, "$(PRECI=3)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(IFS=7.5)")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):current:get")
    info(autosaveFields, "VAL")
}

# The limit the supply reports. Read after every limit write and by the FLNK of
# read_output_status (every SCAN_GET).
record(ai, "$(DEV=AU-20P7)-$(UNITNUM):current:get") {
    field(DESC, "Get current of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=matsusada_co_ctrl.proto) get_current($(UNITNUM)) $(PORT)")
    field(EGU,  "$(EGUI=mA)")
    field(PREC, "$(PRECI=3)")
    field(LINR, "SLOPE")
    field(ESLO, "1.5259021896696422e-05")
    field(ASLO, "$(IFS=7.5)")
}

record(ai, "$(DEV=AU-20P7)-$(UNITNUM):current:read") {
    field(DESC, "Read current of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=matsusada_co_ctrl.proto) read_current($(UNITNUM)) $(PORT)")
    field(EGU,  "$(EGUI=mA)")
    field(PREC, "$(PRECI=3)")
    field(LINR, "SLOPE")
    field(ESLO, "2.442002442002442e-04")
    field(ASLO, "$(IFS=7.5)")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):power:read")
}

record(calc, "$(DEV=AU-20P7)-$(UNITNUM):power:read") {
    field(DESC, "Read power of $(PORT):$(UNITNUM)")
    field(INPA, "$(DEV=AU-20P7)-$(UNITNUM):voltage:read NPP MS")
    field(INPB, "$(DEV=AU-20P7)-$(UNITNUM):current:read NPP MS")
    field(CALC, "A*B/$(PDIV=1000)")
    field(PREC, "3")
    field(EGU,  "W")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):_poll:done")
}

# --- fast polling (internal records, _poll) ---------------------------------------------------
# The monitors are read as one cycle: voltage:read -> current:read -> power:read -> _poll:done.
# A new cycle starts when the last one is done AND a tick of SCAN_MON has come since the last
# start (the tick is remembered, not lost while the cycle runs). So each supply has at most one
# monitor request waiting for the line: when the line is full, the supplies of a chain take
# turns and share it evenly; when it is not, every supply is read once per SCAN_MON. Nothing
# about the other supplies of the chain needs to be known.
# Watchdog: if a cycle has not finished after POLL_LIMIT ticks, the next tick starts a new one
# (and _poll:tick shows MINOR while it is late), so a lost forward link cannot stop the polling.
# None of these records turns INVALID when the port is closed (the monitors do).

# Every SCAN_MON: due := 1. VAL counts the ticks the current cycle has been running.
record(calcout, "$(DEV=AU-20P7)-$(UNITNUM):_poll:tick") {
    field(DESC, "Monitor tick (internal)")
    field(UDFS, "NO_ALARM")
    field(SCAN, "$(SCAN_MON=.1 second)")
    field(INPA, "$(DEV=AU-20P7)-$(UNITNUM):_poll:gate.C NPP")
    field(CALC, "E:=A?E+1:0;E")
    field(OOPT, "Every Time")
    field(DOPT, "Use OCAL")
    field(OCAL, "1")
    field(OUT,  "$(DEV=AU-20P7)-$(UNITNUM):_poll:gate.A PP")
    field(HIGH, "$(POLL_LIMIT=30)")
    field(HSV,  "MINOR")
}

# A = due, C = cycle running, D = ticks it has been running. Starts a cycle when due and idle
# (or late), and then clears due and sets running.
record(calcout, "$(DEV=AU-20P7)-$(UNITNUM):_poll:gate") {
    field(DESC, "Starts a monitor cycle (internal)")
    field(UDFS, "NO_ALARM")
    field(INPD, "$(DEV=AU-20P7)-$(UNITNUM):_poll:tick.E NPP")
    field(CALC, "K:=A&&(!C||D>$(POLL_LIMIT=30));A:=K?0:A;C:=K?1:C;K")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(DEV=AU-20P7)-$(UNITNUM):_poll:start PP")
}

# The gate starts the cycle through this soft record: a monitor that fails at once (closed port)
# then does not raise a link alarm in the gate.
record(fanout, "$(DEV=AU-20P7)-$(UNITNUM):_poll:start") {
    field(DESC, "Starts the monitor reads (internal)")
    field(UDFS, "NO_ALARM")
    field(LNK1, "$(DEV=AU-20P7)-$(UNITNUM):voltage:read")
}

# End of a cycle: running := 0, and the gate looks whether the next one is due.
record(dfanout, "$(DEV=AU-20P7)-$(UNITNUM):_poll:done") {
    field(DESC, "End of a monitor cycle (internal)")
    field(UDFS, "NO_ALARM")
    field(VAL,  "0")
    field(OUTA, "$(DEV=AU-20P7)-$(UNITNUM):_poll:tick.E NPP")
    field(OUTB, "$(DEV=AU-20P7)-$(UNITNUM):_poll:gate.C PP")
}

# --- first contact (internal records, _init) --------------------------------------------------

# Until the first answer after the IOC start: REN and SW? every SCAN_STS (and once at PINI).
# Each answer runs the take-over check _init:otake (supply_first_contact.db), which disables the
# probe at the first valid one (STAT DISABLE, no alarm).
record(bi, "$(DEV=AU-20P7)-$(UNITNUM):_init:probe") {
    field(DESC, "First contact: REN, SW? (internal)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=matsusada_co_ctrl.proto) probe($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_STS=1 second)")
    field(PINI, "YES")
    field(UDFS, "NO_ALARM")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(DISV, "1")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):_init:otake")
}

# What follows the take-over of the output state (supply_first_contact.db, _init:otake:off runs
# it by its forward link, once per IOC start): reads the voltage echo (the set point takes it
# over, _init:vtake), sends the current limit if it is not applied (_limit:apply), and GRACE
# seconds later enables OutputIntlk and processes it. A seq: its steps are callbacks, which is
# what the delay needs; none of them switches a simulation mode or copies a value into a record
# that a client writes.
record(seq, "$(DEV=AU-20P7)-$(UNITNUM):output:init") {
    field(DESC, "First contact: echo, limit, gate")
    field(UDFS, "NO_ALARM")
    field(SELM, "All")
    field(DO1,  "1")
    field(LNK1, "$(DEV=AU-20P7)-$(UNITNUM):voltage:get.PROC CA")
    field(DO2,  "1")
    field(LNK2, "$(DEV=AU-20P7)-$(UNITNUM):_limit:apply.PROC NPP")
    field(DLY3, "$(GRACE=5)")
    field(DO3,  "0")
    field(LNK3, "$(DEV=AU-20P7)-$(UNITNUM):OutputIntlk.DISA NPP")
    field(DO4,  "1")
    field(LNK4, "$(DEV=AU-20P7)-$(UNITNUM):OutputIntlk.PROC NPP")
}

# Sends the current limit while it is not applied (never sent since the start: STAT UDF, also
# after autosave restored it; or the supply did not answer or did not take it: INVALID), from
# the first contact on, every SCAN_GET.
record(calcout, "$(DEV=AU-20P7)-$(UNITNUM):_limit:apply") {
    field(DESC, "Sends a limit not yet applied (internal)")
    field(UDFS, "NO_ALARM")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(INPA, "$(DEV=AU-20P7)-$(UNITNUM):current:limit.SEVR NPP")
    field(INPB, "$(DEV=AU-20P7)-$(UNITNUM):_init:probe.DISA NPP")
    field(INPC, "$(DEV=AU-20P7)-$(UNITNUM):current:limit.STAT NPP")
    field(CALC, "(A>=3||C=17)&&B")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(DEV=AU-20P7)-$(UNITNUM):_limit:send PP")
}

# Through a soft record, so that a failing send does not raise a link alarm in _limit:apply.
record(fanout, "$(DEV=AU-20P7)-$(UNITNUM):_limit:send") {
    field(DESC, "Sends the current limit (internal)")
    field(UDFS, "NO_ALARM")
    field(LNK1, "$(DEV=AU-20P7)-$(UNITNUM):current:limit")
}

# --- output ------------------------------------------------------------------------------------

record(bo, "$(DEV=AU-20P7)-$(UNITNUM):SetToggleOutput") {
    field(DESC, "Set value for enabling PS output")
    field(ZNAM, "DISABLED")
    field(ONAM, "ENABLED")
}

# The permit as this IOC sees it, read every SCAN_MON and on every change. A permit PV of another
# IOC whose link is lost turns this record INVALID (LINK) at its next scan: a link to a
# disconnected PV neither processes its record nor reaches a calculation, so OutputIntlk reads
# the permit through this record, whose link (in this IOC) cannot be lost. Also INVALID at the
# start until the permit PV has connected.
record(ai, "$(DEV=AU-20P7)-$(UNITNUM):_permit:read") {
    field(DESC, "Output permit as seen here (internal)")
    field(INP,  "$(PERMIT=interlock_open) CP MS")
    field(SCAN, "$(SCAN_MON=.1 second)")
}

# 0 while the permit is open, INVALID or disconnected (C: this record's own new severity, which
# input A raises to INVALID through MS from _permit:read), otherwise the request. Starts the
# switching sequence (_out:switch) only when the result changes. Disabled until GRACE seconds
# after the first contact (output:init).
record(calcout, "$(DEV=AU-20P7)-$(UNITNUM):OutputIntlk") {
    field(DESC, "Forces the output off, permit open")
    field(INPA, "$(DEV=AU-20P7)-$(UNITNUM):_permit:read CP MS")
    field(INPB, "$(DEV=AU-20P7)-$(UNITNUM):SetToggleOutput CP")
    field(INPC, "$(DEV=AU-20P7)-$(UNITNUM):OutputIntlk.NSEV NPP")
    field(CALC, "(A||C>=3)?0:B")
    field(SCAN, "1 second")
    field(OOPT, "On Change")
    field(DOPT, "Use OCAL")
    field(OCAL, "((A||C>=3)?0:B)?5:6")
    field(OUT,  "$(DEV=AU-20P7)-$(UNITNUM):_out:switch.SELN PP")
    field(DISV, "1")
    field(DISA, "1")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):_permit:latch")
}

# Switching sequence. On (mask 5): _out:limit (REN, CH1 <limit>), then ToggleOutput (RST, SW1,
# SW? compared). Off (mask 6): _out:remote (REN), then ToggleOutput (RST, SW0, SW? compared).
# So the limit at the supply is right whenever an output goes on, also after a power cycle,
# and switching off sends no limit.
record(seq, "$(DEV=AU-20P7)-$(UNITNUM):_out:switch") {
    field(DESC, "Switching sequence (internal)")
    field(UDFS, "NO_ALARM")
    field(SELM, "Mask")
    field(SHFT, "0")
    field(LNK0, "$(DEV=AU-20P7)-$(UNITNUM):_out:limit.PROC PP")
    field(LNK1, "$(DEV=AU-20P7)-$(UNITNUM):_out:remote.PROC PP")
    field(DOL2, "$(DEV=AU-20P7)-$(UNITNUM):OutputIntlk NPP")
    field(LNK2, "$(DEV=AU-20P7)-$(UNITNUM):ToggleOutput PP")
}

record(bo, "$(DEV=AU-20P7)-$(UNITNUM):_out:limit") {
    field(DESC, "Switch on: REN, current limit (internal)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=matsusada_co_ctrl.proto) switch_on_limit($(UNITNUM),$(DEV=AU-20P7)-$(UNITNUM):) $(PORT)")
    field(PRIO, "HIGH")
    field(UDFS, "NO_ALARM")
}

record(bo, "$(DEV=AU-20P7)-$(UNITNUM):_out:remote") {
    field(DESC, "Switch off: REN (internal)")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=matsusada_co_ctrl.proto) remote($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(UDFS, "NO_ALARM")
}

# The latch: while the permit is lost the request is cleared, so that nothing switches on when
# the permit comes back, and a request made while the permit is lost is cleared at once.
record(calcout, "$(DEV=AU-20P7)-$(UNITNUM):_permit:latch") {
    field(DESC, "Permit lost: request := 0 (internal)")
    field(UDFS, "NO_ALARM")
    field(INPA, "$(DEV=AU-20P7)-$(UNITNUM):OutputIntlk.A NPP")
    field(INPB, "$(DEV=AU-20P7)-$(UNITNUM):OutputIntlk.C NPP")
    field(CALC, "A||B>=3")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "0")
    field(OUT,  "$(DEV=AU-20P7)-$(UNITNUM):SetToggleOutput PP")
}

# Sends RST (cancel a cut-off) and SW, reads SW? back and compares it, after _out:limit or
# _out:remote (REN) of the switching sequence. In simulation mode only while the first contact
# takes it over (supply_first_contact.db). A client that writes ToggleOutput directly bypasses
# the permit, REN and the limit.
record(bo, "$(DEV=AU-20P7)-$(UNITNUM):ToggleOutput") {
    field(DESC, "Toggle the status of the PS output")
    field(DTYP, "stream")
    field(OUT,  "@$(PROTO=matsusada_co_ctrl.proto) toggle_output($(UNITNUM)) $(PORT)")
    field(PRIO, "HIGH")
    field(ZNAM, "DISABLED")
    field(ONAM, "ENABLED")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):read_output_status.PROC CA")
}

# STS: output really on (CO) or off (CF), and remote (RM) or local (LO). 0 and 1 are the lab's
# OFF and ON in remote mode; in local mode (front panel) 2 and 3, MINOR. Differs from
# read_output_status after a cut-off.
record(mbbi, "$(DEV=AU-20P7)-$(UNITNUM):status:read") {
    field(DESC, "Read status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=matsusada_co_ctrl.proto) read_status($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_STS=1 second)")
    field(ZRST, "OFF")
    field(ONST, "ON")
    field(TWST, "OFF, LOCAL")
    field(THST, "ON, LOCAL")
    field(TWSV, "MINOR")
    field(THSV, "MINOR")
}

# The SW setting (SW?). It changes only by a switching command, so it is read after each one
# (FLNK of ToggleOutput) and otherwise slowly. Its FLNK reads the current limit back.
record(bi, "$(DEV=AU-20P7)-$(UNITNUM):read_output_status") {
    field(DESC, "Read output status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP,  "@$(PROTO=matsusada_co_ctrl.proto) get_output_status($(UNITNUM)) $(PORT)")
    field(SCAN, "$(SCAN_GET=5 second)")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(FLNK, "$(DEV=AU-20P7)-$(UNITNUM):current:get")
}
