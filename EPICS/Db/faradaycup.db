# faradaycup.db - Faraday cup readout, Arduino Opta on a USB serial line, libcom1
#
# From the lab's IOC.faraday.db (reference/lab-2026/EPICS/Db, copied from the rack computer on
# 2026-11-24), same record names. Loaded there as DEVICE=FC1 on COM16, 115200 8N1
# (reference/lab-2026/EPICS/st.cmd, lines 49 to 57).
#
# Two values in the query-all order, i1 and i2. NOT KNOWN: what they are and their unit. The
# lab's descriptions say "Get i1 flow" and "Get i2 current"; the sketch of this Opta was not
# found. So EGU is left empty. PREC is ours (display only, the old placeholder's 9 digits).
#
# Firmware: the boards as last flashed speak libcom1 protocol 1 (reference/lab-2026/README.md):
# the query A works, identity (I) and acknowledged sets (S) do not. Nothing here needs more than
# A. Do NOT load libcom1_device.db for this device until its firmware is known to be protocol 2:
# its records would only be INVALID.
#
# Added to the lab's file: MS on the CA links (EPICS/README, "Alarms": a silent board turns
# every value INVALID), PREC.
#
# Macros:
#   DEVICE  PV prefix (FC1 in the lab)
#   PORT    asyn port (AVR16 in the lab)
#   PREC    digits shown, default 9
#
#   dbLoadRecords("db/faradaycup.db", "PORT=AVR16,DEVICE=FC1")

record(aai, "$(DEVICE):data") {
    field(DESC, "FC1 from OPTA")
    field(DTYP, "stream")
    field(INP, "@libcom1.proto read_all_array $(PORT)")
    field(SCAN, ".5 second")
    field(NELM, "2")
    field(FTVL, "DOUBLE")
    field(FLNK, "$(DEVICE):int:fanout.PROC PP")
}

record(fanout, "$(DEVICE):int:fanout") {
    field(SELM, "All")
    field(LNK0, "$(DEVICE):i1:getcurrent")
    field(LNK1, "$(DEVICE):i2:getcurrent")
}

record(ai, "$(DEVICE):i1:getcurrent") {
    field(DESC, "Get i1 flow")
    field(INP, "$(DEVICE):data.VAL[0] CA MS")
    field(SCAN, "Passive")
    field(PREC, "$(PREC=9)")
}

record(ai, "$(DEVICE):i2:getcurrent") {
    field(DESC, "Get i2 current")
    field(INP, "$(DEVICE):data.VAL[1] CA MS")
    field(SCAN, "Passive")
    field(PREC, "$(PREC=9)")
}
