# 99-mist2-matsusada.rules - Matsusada USB adapters of the rack computer on Linux
#
# The CO-U32 holds an FTDI USB-serial chip that reports Matsusada's own USB ID, 1192:1000
# (Matsusada driver CD rev. 1.7.0 and driver package rev. 2.12.36.20: MTPBUS.inf, MTPPORT.inf;
# the owner's notes of about 2016). Both packages name this one ID only.
# The kernel's FTDI driver (ftdi_sio) drives the chip but does not list that ID, so the adapter
# gets no serial device by itself. Rule 1 names the ID to the driver. Rule 3 gives the adapter
# the name that iocBoot/iocRack/ports.real.cmd opens.
#
# Rule 1 seen to work on the rack server (Ubuntu 26.04.1, 2026-11-24): both adapters, ID 1192:1000,
# got their serial device. Rule 3 does not match there: the adapters report no serial number over
# USB (one shared name under /dev/serial/by-id/). Install and check: README.md in this directory.

# 1. A Matsusada USB module appears: load the FTDI driver and name the ID to it, once.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1192", ATTR{idProduct}=="1000", \
  RUN+="/sbin/modprobe -b ftdi_sio", \
  RUN+="/bin/sh -c 'grep -q 1192.1000 /sys/bus/usb-serial/drivers/ftdi_sio/new_id || echo 1192 1000 > /sys/bus/usb-serial/drivers/ftdi_sio/new_id'"

# 2. Only the IOC talks on this line: ModemManager, where installed, must not probe it.
ATTRS{idVendor}=="1192", ATTRS{idProduct}=="1000", ENV{ID_MM_DEVICE_IGNORE}="1"

# 3. Fixed name, by the serial number of the adapter. CO001144 is the CO-U32 (its sticker). This
#    works only if the adapter reports that serial number over USB under Linux, and the Windows
#    list does not suggest it: Windows on the rack computer named all three Matsusada adapters
#    after their USB socket, with no serial number (reference/lab-2026/rack-serial-devices.txt,
#    lines 14 to 16 and 28 to 30). If /dev/mist2/co-u32 does not appear, name both adapters in
#    ports.real.cmd by their /dev/serial/by-path/ name (docs/emulation/LAB-SETUP.md, section 3).
#    The USB-OPT (sticker 024152MP) has no line here for the same reason.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1192", ATTRS{idProduct}=="1000", ATTRS{serial}=="CO001144", SYMLINK+="mist2/co-u32"
