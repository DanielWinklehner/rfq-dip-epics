# Settings of the MIST-2 RAS development stack.
# `make dev-up` copies this file to .env if .env does not exist. Edit .env, not
# this file, for local changes. .env is not under version control.

# ---- Channel Access: the ONLY place for the CA settings of the GUI ----------
# pvServer runs with host networking. The emulated IOCs live on the Docker
# bridge network 172.30.0.0/24 (DESIGN.md section 2) and are found through the
# subnet broadcast address of that network.
EPICS_CA_AUTO_ADDR_LIST=NO
EPICS_CA_ADDR_LIST=172.30.0.255

# ---- Ports (all on the host network of WSL2) ---------------------------------
# nginx: the URL the browser opens, http://localhost:${RAS_HTTP_PORT}/
RAS_HTTP_PORT=3000
# Vite development server, bound to 127.0.0.1 only, reached through nginx.
RAS_VITE_PORT=3001
# pvServer (Flask-SocketIO). Its socket binds 0.0.0.0 (fixed in pvServer.py).
pvServerPort=9001
# pvServer only uses this to print its URL and to choose https if it says https.
pvServerURL=http://127.0.0.1

# ---- Login ------------------------------------------------------------------
# Disabled for development on a private machine. Enabling it needs the admin
# database (MongoDB), see UPSTREAM.md.
VITE_EnableLogin=false

# ---- pvServer logging (stdout, read it with `make dev-logs`) -----------------
pvServerLogLevel=INFO
