# Settings of the MIST-2 data logger (logger/README.md). `make -C logger up` copies this file to
# .env if there is none. Edit .env, not this file. .env is not under version control.

# ---- Database (TimescaleDB): the logger's user and the read-only user of Grafana and the
# reading tool. Change both passwords before the first start on a real computer.
MIST2LOG_DB_PASSWORD=mist2log-change-me
MIST2LOG_READER_PASSWORD=reader-change-me

# ---- Channel Access: where the IOCs are. Emulation: the broadcast address of its Docker network
# (emulation/compose.yaml, MIST2_SUBNET). Real system: the broadcast address of the control
# network, or the addresses of the two IOC computers.
EPICS_CA_AUTO_ADDR_LIST=NO
EPICS_CA_ADDR_LIST=172.30.0.255

# ---- Ports. Bound to MIST2LOG_BIND only (127.0.0.1: this computer). 0.0.0.0 opens them to the
# network. The GUI uses 3000, 3001 and 9001.
MIST2LOG_BIND=127.0.0.1
MIST2LOG_DB_PORT=5434
MIST2LOG_GRAFANA_PORT=3300
GRAFANA_ADMIN_PASSWORD=admin-change-me

# ---- Logger
# Rows kept in memory while the database is lost: about 4 hours of the full emulation at
# 124 rows per second, at most about 300 MB (152 bytes per row; LOGGER.md, sizing)
MIST2LOG_BUFFER_ROWS=2000000
# A time stamp further than this from the logger's clock is replaced by it (seconds)
MIST2LOG_CLOCK_SKEW_S=10
# The registry the PV list comes from (generated by plan/registry.py)
MIST2LOG_REGISTRY_FILE=../RAS/mist2/ReactApp/src/registry/registry.json
