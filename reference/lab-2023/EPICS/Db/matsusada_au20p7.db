record(bo, "AU-20P7-$(UNITNUM):SetToggleOutput") {
	field(DESC, "Set value for enabling PS output")
	field(ZNAM, "DISABLED")
	field(ONAM, "ENABLED")
	field(SCAN, "Passive")
}

record(calcout, "AU-20P7-$(UNITNUM):OutputIntlk") {
	field(DESC, "Checks for the interlock being open")
	field(INPA, "interlock_open CPP")
	field(INPB, "AU-20P7-$(UNITNUM):SetToggleOutput CPP")
	field(CALC, "A ? 0 : B") # if the interlock is open: 0, otherwise SetToggleOutput
	field(SCAN, ".1 second")
	field(OOPT, "On Change") # only write to the output if the value changes
	field(DOPT, "Use CALC") # writes the output of calc
	field(OUT, "AU-20P7-$(UNITNUM):ToggleOutput PP")
}

record(bo, "AU-20P7-$(UNITNUM):ToggleOutput") {
	field(DESC, "Toggle the status of the PS output")
	field(DTYP, "stream")
	field(ZNAM, "DISABLED")
	field(ONAM, "ENABLED")
	field(SCAN, "Passive")
	field(OUT, "@matsusada_co_ctrl.proto toggle_output($(UNITNUM)) $(PORT)")
}

record(bi, "AU-20P7-$(UNITNUM):status:read") {
    field(DESC, "Read status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP, "@matsusada_co_ctrl.proto read_status($(UNITNUM)) $(PORT)")
    field(SCAN, ".1 second")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

#read_output_status
record(bi, "AU-20P7-$(UNITNUM):read_output_status") {
    field(DESC, "Read output status of $(PORT):$(UNITNUM)")
    field(DTYP, "stream")
    field(INP, "@matsusada_co_ctrl.proto get_output_status($(UNITNUM)) $(PORT)")
    field(SCAN, "1 second")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

record(calc, "AU-20P7-$(UNITNUM):power:read") {
   field(DESC, "Read power of $(PORT):$(UNITNUM)")
   field(INPA, "AU-20P7-$(UNITNUM):voltage:read.VAL NPP")
   field(INPB, "AU-20P7-$(UNITNUM):current:read.VAL NPP")
   field(CALC, "A * B / 1000")
   field(SCAN, ".1 second")
   field(PREC, "3")
   field(EGU, "W")
}
